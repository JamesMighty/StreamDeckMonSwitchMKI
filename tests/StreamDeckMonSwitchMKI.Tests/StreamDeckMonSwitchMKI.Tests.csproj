<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>StreamDeckMonSwitch.Tests</RootNamespace>
    <AssemblyName>StreamDeckMonSwitchMKI.Tests</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Fleck" Version="1.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="StreamDeckMonitorSwitch">
      <HintPath>..\..\backend\bin\Debug\StreamDeckMonSwitchMKI.sdPlugin\StreamDeckMonitorSwitch.exe</HintPath>
    </Reference>
    <Reference Include="Svg">
      <HintPath>..\..\backend\bin\Debug\StreamDeckMonSwitchMKI.sdPlugin\Svg.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- The plugin exe's dependencies are not flowed transitively through an
       <Reference> on a .exe, so copy the entire plugin output next to the tests. -->
  <PropertyGroup>
    <PluginOutputDir>$(MSBuildThisFileDirectory)..\..\backend\bin\Debug\StreamDeckMonSwitchMKI.sdPlugin\</PluginOutputDir>
  </PropertyGroup>
  <Target Name="CopyPluginOutput" AfterTargets="Build">
    <ItemGroup>
      <PluginFiles Include="$(PluginOutputDir)**\*.*" Exclude="$(PluginOutputDir)**\*.pdb;$(PluginOutputDir)app.publish\**" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(OutDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
